{
  "name": "token-meter",
  "version": "0.1.0",
  "description": "An open-source, session-aware live token meter for Codex Desktop.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Sergio Chan",
  "homepage": "https://github.com/SergioChan/token-meter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SergioChan/token-meter.git"
  },
  "bugs": {
    "url": "https://github.com/SergioChan/token-meter/issues"
  },
